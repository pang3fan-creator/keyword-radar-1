# Copy to .env and fill in. .env is ignored by git; this file is not.
# The CLI loads .env from the repository root automatically (radar/env.py).

# Required: AIsa (X posts, Google Trends, search volumes, the models)
AISA_API_KEY=

# Required for the daily delivery: Apify (TikTok's US sound charts; about $0.003 a row)
APIFY_TOKEN=

# Optional: Product Hunt launches (developer token from the API dashboard)
# PH_API_KEY=

# Optional: GoAnyAPI (related queries and one-country Trends series)
GOANYAPI_API_KEY=

# Optional: raises the GitHub rate limit (the old breakout signal)
# GITHUB_TOKEN=

# Optional: the weekly revenue signal (TrustMRR, no longer wired into daily)
# TRUSTMRR_API_KEY=

# Optional: mail the report (not used in v1)
# RESEND_API_KEY=
# EMAIL_FROM=
# RADAR_EMAIL_TO=

# Optional: Search Console (the old gsc signal, no longer wired into daily)
# GSC_TOKEN_JSON=
